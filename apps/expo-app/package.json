{
    "name": "expo-app",
    "version": "0.0.0",
    "private": true,
    "description": "_CHANGE_ME_DESCRIPTION_",
    "main": "expo-router/entry",
    "scripts": {
        "dev": "CI=1 expo start",
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "build": "NODE_OPTIONS=--require=./ssr-polyfills.cjs expo export -p web",
        "lint": "oxlint --fix .",
        "check": "oxlint --fix . && oxfmt .",
        "cleanup": "pnpm dlx del-cli node_modules dist web-build .expo",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "test": "jest --ci",
        "test-watch": "jest --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@expo/vector-icons": "^15.1.1",
        "@react-navigation/native": "^7.3.17",
        "expo": "~57.0.16",
        "expo-constants": "~57.0.14",
        "expo-font": "~57.0.1",
        "expo-linking": "~57.0.7",
        "expo-router": "~57.0.16",
        "expo-splash-screen": "~57.0.8",
        "expo-status-bar": "~57.0.1",
        "expo-web-browser": "~57.0.2",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-native": "0.86.2",
        "react-native-reanimated": "~4.6.0",
        "react-native-safe-area-context": "~5.9.1",
        "react-native-screens": "~4.27.0",
        "react-native-web": "~0.21.2",
        "react-native-worklets": "0.12.1"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.0.1",
        "@types/jest": "^30.0.0",
        "@types/react": "~19.2.18",
        "jest": "^30.4.2",
        "jest-expo": "^57.0.4",
        "npm-check-updates": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "typescript": "catalog:"
    }
}
