{
    "name": "tanstack-start",
    "private": true,
    "description": "_CHANGE_ME_DESCRIPTION_",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "start": "node .output/server/index.mjs",
        "cleanup": "pnpm dlx del-cli node_modules .output .vinxi dist tests-results",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "test-report": "pnpm dlx serve tests-results -l 9000 -s -n -C",
        "test-coverage": "pnpm run typegen && vitest run --coverage",
        "test-ui": "pnpm run typegen && vitest --ui",
        "test": "pnpm run typegen && vitest --run",
        "lint": "oxlint --fix .",
        "check": "oxlint --fix . && oxfmt .",
        "e2e-install": "playwright install --with-deps",
        "e2e-chrome": "playwright test --headed --project Chromium",
        "e2e-firefox": "playwright test --headed --project Firefox",
        "e2e-mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e-safari": "playwright test --headed --project Safari",
        "e2e-report": "playwright show-report tests-results/e2e-html",
        "e2e-ui": "playwright test --ui",
        "e2e": "playwright test",
        "typegen": "tsr generate",
        "typecheck": "pnpm run typegen && tsc --noEmit"
    },
    "dependencies": {
        "@repo/shared-ui": "workspace:*",
        "@tanstack/react-router": "1.170.32",
        "@tanstack/react-router-devtools": "1.167.1",
        "@tanstack/react-start": "1.168.49",
        "consola": "^3.4.2",
        "lucide-react": "^1.34.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "std-env": "^4.2.0",
        "tailwind-variants": "^3.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/router-cli": "1.167.33",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "dotenv": "^17.4.2",
        "happy-dom": "^20.11.6",
        "nitro": "3.0.260610-beta",
        "npm-check-updates": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "playwright": "^1.62.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-motion": "^1.1.1",
        "typescript": "catalog:",
        "vite": "~8.2.2",
        "vite-plugin-devtools-json": "^1.1.0",
        "vitest": "^4.1.11"
    }
}
