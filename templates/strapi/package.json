{
  "name": "{{ package_name | kebab_case }}",
  "private": true,
  "description": "{{ package_description }}",
  "scripts": {
    "dev": "strapi develop",
    "build": "strapi build --stats",
    "start": "NODE_ENV=production strapi start",
    "start-node": "NODE_ENV=production node --no-warnings -r dotenv/config server.cjs",
    "cleanup": "pnpm dlx del-cli node_modules build dist .{cache,data,strapi,tmp} _data",
    "update-deps": "npm-check-updates --configFileName .ncurc.json",
    "lint": "oxlint --fix .",
    "check": "oxlint --fix . && oxfmt .",
    "typecheck": "tsc --noEmit",
    "strapi": "strapi"
  },
  "dependencies": {
    "@strapi/plugin-documentation": "5.52.1",
    "@strapi/plugin-users-permissions": "5.52.1",
    "@strapi/provider-email-nodemailer": "5.52.1",
    "@strapi/provider-upload-aws-s3": "5.52.1",
    "@strapi/strapi": "5.52.1",
    "@strapi/upload": "5.52.1",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "react-router-dom": "~6.29.0",
    "sharp": "^0.35.3",
    "std-env": "^4.2.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@strapi/typescript-utils": "5.52.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "~6.3.5"
  },
  "strapi": {}
}
