{
    "extends": ["../../.oxlintrc.json"],
    "categories": {
        "correctness": "off",
        "nursery": "off",
        "pedantic": "off",
        "perf": "off",
        "restriction": "off",
        "style": "off",
        "suspicious": "off"
    },
    "rules": {
        "import/no-unassigned-import": [
            "warn",
            {
                "allow": ["**/*.css", "@testing-library/jest-dom/vitest", "dotenv/config"]
            }
        ]
    }
}
