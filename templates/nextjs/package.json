{
  "name": "{{ package_name | kebab_case }}",
  "private": true,
  "description": "{{ package_description }}",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix .",
    "check": "oxfmt .",
    "cleanup": "pnpm dlx del-cli node_modules .{cache,data,next,tmp} dist tests-results",
    "update-deps": "npm-check-updates --configFileName .ncurc.json",
    "test-report": "pnpm dlx serve tests-results -l 9000 -s -n -C",
    "test-coverage": "vitest run --coverage",
    "test-ui": "vitest --ui",
    "test": "vitest --run",
    "e2e-install": "playwright install --with-deps",
    "e2e-chrome": "playwright test --headed --project Chromium",
    "e2e-firefox": "playwright test --headed --project Firefox",
    "e2e-mobile": "playwright test --headed --project 'Mobile Chrome'",
    "e2e-safari": "playwright test --headed --project Safari",
    "e2e-report": "playwright show-report tests-results/e2e-html",
    "e2e-ui": "playwright test --ui",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "std-env": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-config-next": "16.3.2",
    "happy-dom": "^20.11.6",
    "npm-check-updates": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
