{
    "name": "@repo/{{ package_name | kebab_case }}",
    "private": true,
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        "./components": "./src/components/index.ts",
        "./hooks": "./src/hooks/index.ts",
        "./theme": "./src/theme.tsx",
        "./utils": "./src/utils.ts"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "NODE_ENV=production vite build",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook-build": "storybook build -o storybook-static",
        "cleanup": "pnpm dlx del-cli dist node_modules pnpm-lock.yaml storybook-static",
        "start": "pnpm dlx local-web-server -p 6006 -d storybook-static",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "prepublishOnly": "pnpm run build:vite",
        "lint": "oxlint --fix .",
        "check": "oxlint --fix . && oxfmt .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@nanostores/persistent": "^1.3.5",
        "@nanostores/react": "^1.1.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.5.0",
        "lucide-react": "^1.34.0",
        "nanostores": "^1.5.2",
        "radix-ui": "^1.6.7",
        "react-day-picker": "^9.14.0",
        "react-hook-form": "^7.86.0",
        "react-resizable-panels": "^3.0.6",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "vaul": "^1.1.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@storybook/addon-a11y": "10.5.10",
        "@storybook/addon-docs": "10.5.10",
        "@storybook/addon-links": "10.5.10",
        "@storybook/addon-themes": "10.5.10",
        "@storybook/react-vite": "10.5.10",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "consola": "^3.4.2",
        "npm-check-updates": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "std-env": "^4.2.0",
        "storybook": "10.5.10",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tailwindcss-motion": "^1.1.1",
        "typescript": "catalog:",
        "vite": "~8.2.2",
        "vite-plugin-dts": "^5.0.3"
    },
    "peerDependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    }
}
